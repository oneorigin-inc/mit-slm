# ============================================
# SLM Badge Generator Configuration
# ============================================

# Ollama Configuration
OLLAMA_API_URL=http://localhost:11434/api/generate
MODEL_NAME=phi4-chat:latest

# Badge Image Service Configuration
BADGE_IMAGE_SERVICE_URL=http://localhost:3001

# ============================================
# RAG Vector Database Configuration
# ============================================

# Automatically update vector database with new badges
# When enabled, each generated badge is added to the vector database
# for future retrieval as few-shot examples (true/false)
AUTO_UPDATE_VECTOR_DB=true

# GPU Acceleration for RAG embeddings (true/false)
# Set to true to use GPU for embedding model, false for CPU
RAG_USE_GPU=false

# Similarity threshold for adding new badges to vector database (0.0-1.0)
# New badges are added ONLY if their similarity to existing badges is BELOW this threshold
# Lower value (e.g., 0.70) = more strict, only very different badges are added
# Higher value (e.g., 0.90) = more lenient, more badges are added
# Recommended: 0.85 (85% similarity threshold)
RAG_SIMILARITY_THRESHOLD=0.85

# ============================================
# LAiSER Skill Extraction Configuration
# ============================================


# HuggingFace model for skill extraction (NOT GGUF format)
# Recommended: bert-base-uncased, distilbert-base-uncased, roberta-base
LAISER_MODEL_ID=bert-base-uncased

# HuggingFace API Token (get yours at https://huggingface.co/settings/tokens)
LAISER_HF_TOKEN=

# GPU Acceleration (set to true after GPU setup - see GPU_INSTALL.txt)
LAISER_USE_GPU=false

# Number of skills to extract per badge (5-20 recommended)
LAISER_TOP_K=10
