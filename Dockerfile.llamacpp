# Minimal llama.cpp-only Dockerfile (excludes LAiSER and heavy ML dependencies)
# Final image size: ~2-3 GB (models mounted as volume, not copied)

# ============== BUILDER STAGE ==============
FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies for llama-cpp-python (needed for compilation)
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    cmake \
    make \
    && rm -rf /var/lib/apt/lists/*

# Install only essential dependencies (NO PyTorch, NO transformers, NO LAiSER)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    fastapi==0.104.1 \
    uvicorn[standard]==0.24.0 \
    pydantic==2.5.0 \
    pydantic-settings==2.1.0 \
    httpx==0.25.2 \
    python-multipart==0.0.6 \
    requests>=2.32.2 \
    python-dotenv>=0.19.0 \
    beautifulsoup4==4.12.2 \
    lxml==4.9.3 \
    nltk==3.8.1 \
    numpy>=1.26.0 \
    scikit-learn>=1.3.0 \
    llama-cpp-python>=0.2.0\
    pandas==2.2.2

# ============== RUNTIME STAGE ==============
FROM python:3.11-slim

WORKDIR /app

# Install only runtime dependency for llama.cpp
RUN apt-get update && apt-get install -y \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder (not bloat from build tools)
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY app/ app/
COPY assets/ assets/

# Copy models directory (includes GGUF models for AWS deployment)
COPY models/ models/

# Copy .env if exists (otherwise create empty)
COPY .env* ./
RUN if [ ! -f .env ]; then touch .env; fi

# Expose port
EXPOSE 8000

# Set environment variables
ENV LLM_PROVIDER=llamacpp
ENV PYTHONUNBUFFERED=1
ENV LLAMACPP_MODEL_SOURCE=local
ENV LLAMACPP_MODEL_PATH=/app/models/model.gguf
ENV LLAMACPP_N_CTX=4096
ENV LLAMACPP_N_GPU_LAYERS=0

# Run the application
CMD ["python", "-m", "app.main"]